<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kimo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>kimo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ADMOB UYGULAMA KİMLİĞİ — EKSİKSE SDK "GADInvalidInitializationException"
	     ile çöküyor. Varsayılan Google'ın AÇIK TEST kimliği; yayın derlemesinde
	     xcconfig'ten gelen $(ADMOB_APP_ID) ile değiştirilmeli.
	
	     NSUserTrackingUsageDescription BİLEREK EKLENMEDİ: ATT hiç çağrılmıyor,
	     IDFA istenmiyor ve yalnızca kişiselleştirilmemiş reklam gösteriliyor
	     (ageRestrictedTreatment: teen). Bu sayede App Store Connect'teki
	     "Used to Track: Hayır" cevabı aynen doğru kalıyor. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<!-- SKAdNetwork: reklam verenin yükleme ilişkilendirmesi için; BİZDEN veri
	     toplamıyor. Aşağıda yalnızca Google'ın kendi kimliği var.
	
	     YAYIN ÖNCESİ: tam liste Google'ın yayımladığı SKAdNetwork listesinden
	     KOPYALANMALI. Eksik kimlikler zarar vermez (yalnızca o ağların
	     ilişkilendirmesi çalışmaz), ama uydurma kimlik yazmak yanlış olurdu —
	     o yüzden liste burada bilinçli olarak kısa. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Soru fotoğrafı çekmek ve profil fotoğrafı eklemek için kamera kullanılır.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Galeriden soru veya profil fotoğrafı seçebilmen için fotoğraflarına erişilir.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- PORTRE KİLİDİ (Task 03 kapanışı): arayüz portre-öncelikli tasarlandı
	     ve yatay hiç test edilmedi; cihaz yan çevrilince dönmez. iPad'de tüm
	     yönler desteklenmediği için UIRequiresFullScreen beyanı ZORUNLU
	     (App Store multitasking kuralı). -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
