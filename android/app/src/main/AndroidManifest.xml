<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Ağ erişimi (Supabase). Release derlemesinde de gerekli; Flutter bunu
         yalnızca debug/profile manifest'ine koyduğu için elle ekliyoruz. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- AŞAĞIDAKİ İKİ İZİN VE ALICI, eklenti manifest'lerinden (manifest
         merge) zaten geliyor olabilir; yine de AÇIKÇA beyan ediyoruz (Task 03,
         bulgu 7.2). Sebep: uygulamanın hangi izinlere dayandığı depodan
         okunabilmeli — eklenti sürümü değişip beyanı bırakırsa davranış
         sessizce bozulmasın.

         POST_NOTIFICATIONS: Android 13+ bildirim izni (requestPermission
         çağrısının karşılığı). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- RECEIVE_BOOT_COMPLETED: cihaz yeniden başlatıldığında planlanmış
         hatırlatmalar geri kurulsun; yoksa her yeniden başlatma o günün
         hatırlatmalarını sessizce siliyordu. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- REKLAM KİMLİĞİ (AAID) BİLİNÇLİ OLARAK DÜŞÜRÜLÜYOR (Task 10).
         `google_mobile_ads` bu izni kendi manifest'inden MERGE ile ekliyor;
         burada `tools:node="remove"` ile çıkarıyoruz.

         NEDEN: hedef kitle 13-18 ve kişiselleştirilmiş reklam kullanılmıyor
         (`ageRestrictedTreatment: teen`, istekte `npa=1`). İzin düşünce
         Play Veri Güvenliği formundaki "Reklam kimliği: HAYIR" ve App Store
         Connect'teki "Used to Track: Hayır" cevapları AYNEN doğru kalıyor.

         BEDELİ AÇIKÇA: sıklık sınırlama (frequency capping) zayıflar ve
         doluluk bir miktar düşer. Bu bilinçli bir takas — reklamın işi gelir
         değil, hak duvarına bir kapı açmak.

         GERİ ALMAK İSTENİRSE: bu satırı silmek YETMEZ; mağaza formlarındaki
         iki cevap ve hukuki metinlerdeki alıcı listesi de güncellenmeli. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>

    <application
        android:label="Kimo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Yeniden başlatma sonrasında flutter_local_notifications'ın
             planlanmış bildirimleri geri kurması için alıcı. Eklenti kendi
             manifest'inde de taşıyor; açık beyanın gerekçesi yukarıdaki izin
             bloğundakiyle aynı. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- ADMOB UYGULAMA KİMLİĞİ — EKSİKSE UYGULAMA AÇILIŞTA ÇÖKÜYOR.
             Belgelenmiş davranış: meta-data yoksa SDK "Missing application
             ID" ile süreci düşürüyor. Yani bu satır bir yapılandırma
             ayrıntısı değil, bir açılış koşulu.

             Varsayılan GOOGLE'IN AÇIK TEST KİMLİĞİ: gerçek AdMob hesabı
             açılmadan önce de derleme çalışıyor ve hiçbir sürümde gerçek
             reklam gösterilmiyor. Sürümde `android/key.properties` deseninin
             aynısıyla geçersiz kılınıyor:

               android/app/build.gradle.kts → manifestPlaceholders

             `${admobAppId}` yer tutucusu Gradle'dan geliyor. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
